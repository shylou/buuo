# Buuo Environment Variables
# Copy this file to .env and fill in your values

# Lark/Feishu - Required
LARK_APP_ID=cli_xxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxx

# Claude Code CLI (Optional)
# Defaults to system-installed claude command
# CLAUDE_CLI_PATH=/custom/path/to/claude

# Configuration (Optional)
# CONFIG_PATH=config/default.config.yaml
