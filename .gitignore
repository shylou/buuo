# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# TypeScript compiled output (outside dist/)
# Only .ts source files should be tracked; compiled .js/.d.ts/.map are generated
**/test/**/*.js
**/test/**/*.d.ts
**/test/**/*.js.map
**/test/**/*.d.ts.map

# Environment files
.env
.env.local
.env.*.local

# MCP configuration (contains API keys)
.mcp.json

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage/

# Temporary files
*.tmp
.cache/

# Buuo runtime
.buuo_gateway.pid
