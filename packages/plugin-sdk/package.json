{
  "name": "@buuo/plugin-sdk",
  "version": "0.1.0",
  "description": "Buuo Plugin SDK - Tools for developing Buuo plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./channel": {
      "types": "./dist/channel.d.ts",
      "default": "./dist/channel.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "default": "./dist/provider.js"
    },
    "./skill": {
      "types": "./dist/skill.d.ts",
      "default": "./dist/skill.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "plugin",
    "sdk",
    "development"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@buuo/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@buuo/core": "^0.1.0"
  }
}
